{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:holistic-qa:schema:v1:quality-report",
  "title": "Holistic QA quality report",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "recommendation", "decision_owner", "run_ids", "evidence", "gaps", "residual_risks", "verification"],
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "recommendation": { "enum": ["ready", "conditional", "not-ready", "insufficient-evidence"] },
    "decision_owner": { "type": ["string", "null"] },
    "run_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "evidence": { "type": "array" },
    "gaps": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "residual_risks": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "verification": { "type": "array", "minItems": 1 }
  }
}
