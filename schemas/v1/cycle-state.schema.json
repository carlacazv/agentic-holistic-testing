{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:holistic-qa:schema:v1:cycle-state",
  "title": "Holistic QA cycle state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "goal", "invocation", "selected_skills", "completed_skills", "run_ids", "open_questions", "status"],
  "properties": {
    "schema_version": { "const": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "invocation": { "enum": ["orchestrated", "explicit-skill"] },
    "selected_skills": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["plan", "review-plan", "automation-strategy", "implement-playwright", "explore", "accessibility", "performance", "report"] } },
    "completed_skills": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "run_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["active", "waiting", "completed"] }
  }
}
